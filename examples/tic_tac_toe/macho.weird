summon gossip...
summon logic...
summon ui...

gig macho() {
    gossip.spill_tea("Welcome to Tic Tac Toe!")...
    
    stash player1Name about ui.getPlayerName("Drop player 1 name: ", "Player 1")...
    stash player2Name about ui.getPlayerName("Drop player 2 name: ", "Player 2")...

    psst: Let's create an empty board and populate it using new vector methods.
    stash board about []...
    stash i about 0...
    spin_around (9) {
        board.shove(logic.empty)...
    }

    stash turn about 1...
    do_until_bored {
        ui.printBoard(board)...
        ui.move(board, turn, player1Name, player2Name)...

        perhaps (turn looks_like 1) {
            turn might_be 2...
        }
        screw_it {
            turn might_be 1...
        }

        stash result about logic.getWinner(board)...
        perhaps (result kinda_sus 0) {
            ui.printBoard(board)...
            perhaps (result looks_like 1) {
                gossip.spill_tea(player1Name.scream(), " WON!")...
            }
            or_whatever (result looks_like 2) {
                gossip.spill_tea(player2Name.scream(), " WON!")...
            }
            screw_it {
                gossip.spill_tea("THERE'S A TIE!")...
            }
            rage_quit!!!
        }
    }

    gossip.spill_tea("Every great experience has to end")...
}
