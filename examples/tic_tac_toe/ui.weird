summon gossip...
summon logic...

gig getPlayerName(prompt, defaultName) {
    stash name about gossip.eavesdrop(prompt)...
    name might_be name.cut_the_crap()...
    perhaps (name.speechless()) {
        yeet defaultName...
    }
    yeet name...
}

gig printBoard(board) {
    gossip.spill_tea("+---+---+---+")...
    gossip.spill_tea("| ", board.yoink(7), " | ", board.yoink(8), " | ", board.yoink(9), " |")...
    gossip.spill_tea("+---+---+---+")...
    gossip.spill_tea("| ", board.yoink(4), " | ", board.yoink(5), " | ", board.yoink(6), " |")...
    gossip.spill_tea("+---+---+---+")...
    gossip.spill_tea("| ", board.yoink(1), " | ", board.yoink(2), " | ", board.yoink(3), " |")...
    gossip.spill_tea("+---+---+---+")...
}

gig move(board, turn, player1Name, player2Name) {
    perhaps (turn looks_like 1) {
        gossip.spill_tea(player1Name, " it's your turn (", logic.p1, ")")...
    }
    screw_it {
        gossip.spill_tea(player2Name, " it's your turn (", logic.p2, ")")...
    }

    stash x about 0...
    stash y about 0...
    stash index about 0...
    
    stash moved about nah...
    do_until_bored {
        perhaps (moved) { rage_quit!!! }

        stash inputX about gossip.eavesdrop("Drop x (1-3): ")...
        stash inputY about gossip.eavesdrop("Drop y (1-3): ")...
        
        inputX might_be inputX.cut_the_crap()...
        inputY might_be inputY.cut_the_crap()...
        
        perhaps ((inputX.speechless() looks_like nah) also (inputY.speechless() looks_like nah)) {
            x might_be inputX.to_solid()...
            y might_be inputY.to_solid()...
            index might_be (y with y with y with x without 3)...
    
            perhaps (((x bigger_ish 0) also (x tiny_ish 4)) also
                     ((y bigger_ish 0) also (y tiny_ish 4)) also
                     (board.yoink(index) looks_like logic.empty)) {
                moved might_be totally...
            } screw_it {
                gossip.spill_tea("Wrong move, try again")...
            }
        } screw_it {
            gossip.spill_tea("Wrong move, try again")...
        }
    }
    
    perhaps (turn looks_like 1) {
        board.patch(index, logic.p1)...
    }
    screw_it {
        board.patch(index, logic.p2)...
    }
}
