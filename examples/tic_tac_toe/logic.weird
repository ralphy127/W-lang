stash empty about " "...
stash p1 about "X"...
stash p2 about "O"...

gig isWinningLine(board, start, step, mark) {
    yeet ((board.yoink(start) looks_like mark) also
          ((board.yoink(start with step) looks_like mark) also
           (board.yoink(start with step with step) looks_like mark)))...
}

gig hasWinningLine(board, mark) {
    stash rowStart about 1...
    spin_around (3) {
        perhaps (isWinningLine(board, rowStart, 1, mark)) {
            yeet totally...
        }
        rowStart might_be rowStart with 3...
    }

    stash colStart about 1...
    spin_around (3) {
        perhaps (isWinningLine(board, colStart, 3, mark)) {
            yeet totally...
        }
        pump_it colStart...
    }

    perhaps ((isWinningLine(board, 1, 4, mark)) either
             (isWinningLine(board, 3, 2, mark))) {
        yeet totally...
    }

    yeet nah...
}

gig getWinner(board) {
    perhaps (hasWinningLine(board, p1)) {
        yeet 1...
    }

    perhaps (hasWinningLine(board, p2)) {
        yeet 2...
    }

    stash hasEmpty about nah...
    stash index about 1...
    spin_around (board.vibe_count()) {
        perhaps (board.yoink(index) looks_like empty) {
            hasEmpty might_be totally...
            rage_quit!!!
        }
        pump_it index...
    }

    perhaps (hasEmpty) {
        yeet 0...
    }

    yeet 3...
}
