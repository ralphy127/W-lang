summon gossip...

crew Walker {
    packing step...

    hustle addStep(x) {
        yeet x with step...
    }
}

gig macho() {
    stash walker about recruit Walker packing 2...
    stash steps about 0...
    spin_around(5) {
        steps might_be walker.addStep(steps)...
        gossip.spill_tea(steps)...
    }
}
