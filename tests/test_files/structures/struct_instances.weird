summon gossip...

crew A {}
crew B { packing id, name... }

gig macho () {
    stash a about recruit A...
    stash b about recruit B packing 42, "bob"...
    gossip.spill_tea(a)...
    gossip.spill_tea(b)...

    gossip.spill_tea(b.name)...
    b.name might_be "robert"...
    gossip.spill_tea(b.name)...
}