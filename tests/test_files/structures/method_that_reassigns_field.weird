summon gossip...

crew Test {
    packing x...

    hustle printXAndIncreaseBy(amount) {
        gossip.spill_tea(x)...
        x might_be x with amount...
    }
}

gig macho() {
    stash test about recruit Test packing 1...
    spin_around(5) {
        test.printXAndIncreaseBy(2)...
    }
    gossip.spill_tea("end: ", test.x)...
}
