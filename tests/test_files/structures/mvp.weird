summon gossip...

crew Goon {
    packing tag, muscle...

    hustle flex(how_much) {
        spin_around (how_much) {
            pump_it muscle...
            gossip.spill_tea(tag, " is getting huge! Muscle is now: ", muscle)...
        }
    }

    hustle smack(target) {
        gossip.spill_tea(tag, " just dropped a heavy hand on ", target)...
    }
}

gig macho() {
    stash bouncer about recruit Goon packing "The Wall", 60...
    stash thug about recruit Goon packing "Slippery Pete", 30...
    
    gossip.spill_tea("Look out, it's ", bouncer.tag)...
    bouncer.smack(thug.tag)...
    pump_it bouncer.muscle...
    bouncer.flex(4)...
}
